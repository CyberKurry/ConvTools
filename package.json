{
  "name": "convtools",
  "version": "0.1.0",
  "description": "Local-first, modular developer toolbox extension for Chrome and Edge",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:edge": "wxt -b edge",
    "build": "pnpm generate && wxt build",
    "build:chrome": "pnpm generate && wxt build -b chrome",
    "build:edge": "pnpm generate && wxt build -b edge",
    "build:e2e": "pnpm generate && wxt build -b chrome --mode test",
    "generate": "tsx scripts/generate-modules.ts",
    "generated:check": "tsx scripts/generate-modules.ts --check",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "icons:check": "tsx scripts/generate-icons.ts --check",
    "version:get": "tsx scripts/version.ts get",
    "version:sync": "tsx scripts/version.ts sync",
    "module:add": "tsx scripts/module-cli.ts add",
    "module:remove": "tsx scripts/module-cli.ts remove",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit modules",
    "test:e2e": "pnpm build:e2e && playwright test",
    "manifest:audit": "tsx scripts/audit-manifest.ts",
    "check": "pnpm generated:check && pnpm lint && pnpm typecheck && pnpm icons:check && pnpm build:chrome && pnpm build:edge && pnpm manifest:audit && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@js-temporal/polyfill": "0.5.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.1.11",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
